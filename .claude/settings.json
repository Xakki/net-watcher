{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./CLAUDE.local.md)",
      "Read(./.claude/settings.local.json)",
      "Read(./.claude/kanban.lock.flock)",
      "Read(./.claude/kanban.lock.lockdir/**)",
      "Read(./.claude/kanban/grooming/TODO.md)",
      "Read(./.private/**)",
      "Read(./.local/**)",
      "Read(./__pycache__/**)",
      "Read(./**/__pycache__/**)",
      "Read(./*.py[cod])",
      "Read(./**/*.py[cod])",
      "Read(./.coverage)",
      "Read(./htmlcov/**)",
      "Read(./.DS_Store)",
      "Read(./**/.DS_Store)",
      "Read(./*.log)",
      "Read(./**/*.log)",
      "Bash(git push:*)",
      "Bash(git -C * push:*)"
    ],
    "ask": [],
    "allow": []
  }
}
